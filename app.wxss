/**app.wxss**/
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
} 

button {
  background: initial;
}

button:focus{
  outline: 0;
}

button::after{
  border: none;
}


page {
  background: linear-gradient(180deg, #F6F8FC 0%, #F2F4F8 100%);
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

/* 常用全局类（页面可直接复用，不改业务逻辑） */
.muted {
  color: #7A869A;
}

.app-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(16, 24, 40, 0.06);
  border: 1rpx solid rgba(15, 23, 42, 0.06);
}

.app-empty {
  text-align: center;
  color: #9AA3AF;
  margin-top: 80rpx;
  font-size: 26rpx;
}

.news_list {
  padding: 0 20rpx;
}