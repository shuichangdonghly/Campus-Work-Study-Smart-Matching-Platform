@import './users.wxss';

.top-card {
  background: #ffffff;
  border-radius: 22rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 16rpx 40rpx rgba(16, 24, 40, 0.06);
}

.title-main {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
}

.sub {
  display: block;
  font-size: 24rpx;
  color: #7a869a;
  margin-top: 8rpx;
  line-height: 1.45;
}

.filters {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  vertical-align: middle;
  margin-right: 12rpx;
  min-height: 56rpx;
  padding: 0 26rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
  border: 2rpx solid transparent;
}

.chip--neutral {
  background: #f1f5f9;
  color: #475569;
  border-color: rgba(15, 23, 42, 0.1);
}

.chip--recruiting {
  background: #dcfce7;
  color: #166534;
  border-color: rgba(22, 101, 52, 0.2);
}

.chip--progress {
  background: #dbeafe;
  color: #1d4ed8;
  border-color: rgba(29, 78, 216, 0.2);
}

.chip--settling {
  background: #ffedd5;
  color: #c2410c;
  border-color: rgba(194, 65, 12, 0.25);
}

.chip--done {
  background: #e2e8f0;
  color: #475569;
  border-color: rgba(71, 85, 105, 0.25);
}

.chip--dispute {
  background: #fee2e2;
  color: #b91c1c;
  border-color: rgba(185, 28, 28, 0.35);
}

.chip.is-on {
  border-color: #4f46e5;
  box-shadow: 0 0 0 2rpx rgba(79, 70, 229, 0.25);
}

.order-card {
  padding: 28rpx 24rpx;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.job-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.35;
}

.status-pill {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
  min-height: 56rpx;
  min-width: 120rpx;
  box-sizing: border-box;
  text-align: center;
}

.phase-recruiting {
  background: #dcfce7;
  color: #166534;
}

.phase-progress {
  background: #dbeafe;
  color: #1d4ed8;
}

.phase-settling {
  background: #ffedd5;
  color: #c2410c;
}

.phase-done {
  background: #e2e8f0;
  color: #475569;
}

.meta {
  display: block;
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.4;
}

.hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #94a3b8;
}
