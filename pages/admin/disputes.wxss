@import './users.wxss';

.page {
  background: #F5F7FA;
  min-height: 100vh;
  padding: 24rpx 22rpx 40rpx;
  box-sizing: border-box;
}

.title-wrap {
  margin: 8rpx 0 16rpx;
  text-align: center;
}

.title-main {
  font-size: 38rpx;
  font-weight: 700;
  color: #3B6FF5;
  line-height: 1.35;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 22rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 140, 66, 0.12);
  box-shadow: 0 10rpx 26rpx rgba(255, 140, 66, 0.08);
}

.card-focused {
  border-color: rgba(255, 140, 66, 0.45);
  box-shadow: 0 0 0 4rpx rgba(255, 140, 66, 0.15);
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.order-no {
  flex: 1;
  font-size: 26rpx;
  color: #7a4a2a;
  line-height: 1.3;
}

.status-tag {
  flex-shrink: 0;
  background: #FFF1E6;
  color: #FF8C42;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  line-height: 1;
}

.party-card {
  margin-top: 14rpx;
  background: #fffaf5;
  border-radius: 14rpx;
  padding: 16rpx;
}

.party-line {
  display: block;
  font-size: 26rpx;
  color: #3b2c23;
  line-height: 1.45;
}

.reason-line {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #FF8C42;
  font-weight: 600;
  line-height: 1.45;
}

.deposit-info {
  margin-top: 12rpx;
  padding: 12rpx;
  border-radius: 10rpx;
  background: #f8fafc;
  border: 1rpx solid rgba(59, 111, 245, 0.18);
}

.deposit-text {
  display: block;
  font-size: 24rpx;
  color: #475569;
  line-height: 1.5;
}

.deposit-text.total {
  margin-top: 4rpx;
  color: #3B6FF5;
  font-weight: 600;
}

.actions {
  margin-top: 16rpx;
}

.btn-return {
  width: 100%;
  min-height: 80rpx;
  border-radius: 14rpx;
  background: #FF8C42;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.btn-return::after {
  border: none;
}

.btn-reject {
  margin-top: 12rpx;
  width: 100%;
  min-height: 76rpx;
  border-radius: 14rpx;
  background: #ffffff;
  color: #FF8C42;
  border: 2rpx solid #FF8C42;
  font-size: 27rpx;
}

.btn-judge-link {
  margin-top: 8rpx;
  width: 100%;
  min-height: 68rpx;
  border-radius: 12rpx;
  background: transparent;
  color: #3B6FF5;
  font-size: 26rpx;
}

.btn-judge-link::after,
.btn-reject::after {
  border: none;
}

.settlement-actions {
  margin-top: 14rpx;
}

.settlement-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #7a4a2a;
  margin-bottom: 10rpx;
}

.preset-row {
  display: flex;
  gap: 10rpx;
}

.preset-option {
  flex: 1;
  min-height: 88rpx;
  border-radius: 16rpx;
  background: #FFF1E6;
  color: #b25b24;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.preset-option.is-selected {
  background: #FF8C42;
  color: #ffffff;
}

.empty {
  margin-top: 30rpx;
  text-align: center;
  color: #b18b6f;
  font-size: 26rpx;
}

.settlement-modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 24rpx;
  box-sizing: border-box;
}

.settlement-modal {
  width: 100%;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.settlement-modal-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #FF8C42;
}

.settlement-modal-sub {
  display: block;
  margin-top: 8rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #64748b;
}

.settlement-input {
  width: 100%;
  height: 76rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.16);
  border-radius: 12rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  margin-bottom: 12rpx;
  background: #ffffff;
}

.settlement-modal-btns {
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
}

.settlement-modal-btns button {
  flex: 1;
}
