.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #F6F8FC 0%, #F2F4F8 100%);
  padding-bottom: 150rpx;
}

.top-card {
  background: #ffffff;
  border-radius: 22rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 16rpx 40rpx rgba(16, 24, 40, 0.06);
}

.title-main {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
}

.sub {
  display: block;
  font-size: 24rpx;
  color: #7A869A;
  margin-top: 6rpx;
}

.card {
  background: #ffffff;
  padding: 24rpx;
  border-radius: 22rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 16rpx 40rpx rgba(16, 24, 40, 0.06);
}

.row {
  font-size: 30rpx;
  font-weight: 500;
  display: block;
  word-break: break-all;
  overflow-wrap: anywhere;
}

.small {
  font-size: 24rpx;
  color: #555;
  display: block;
  margin: 12rpx 0;
  word-break: break-all;
}

.detail-box {
  background: #F8FAFC;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  margin-bottom: 14rpx;
}

.detail-row {
  display: flex;
  margin-bottom: 8rpx;
  align-items: flex-start;
}

.detail-row:last-child {
  margin-bottom: 0;
}

.detail-label {
  font-size: 24rpx;
  color: #64748B;
  min-width: 170rpx;
  flex-shrink: 0;
}

.detail-value {
  font-size: 24rpx;
  color: #0F172A;
  flex: 1;
  min-width: 0;
  word-break: break-all;
  overflow-wrap: anywhere;
}

.btns {
  display: flex;
  gap: 16rpx;
}

.empty {
  text-align: center;
  color: #888;
  margin-top: 80rpx;
}

.admin-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  display: flex;
  border-top: 1rpx solid rgba(15, 23, 42, 0.08);
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #7A869A;
}

.tab.active {
  color: #4F46E5;
  font-weight: 600;
}
