<view class="page">
  <view class="top-card">
    <text class="title-main">审核中心</text>
    <text class="sub">用户认证与岗位上架由管理员统一处理</text>
  </view>

  <view class="entry-grid">
    <view class="entry-card" bindtap="goReviewUsers">
      <text class="entry-icon">👤</text>
      <text class="entry-title">审核用户资料</text>
      <text class="entry-desc">查看学生与发布方认证信息</text>
    </view>
    <view class="entry-card" bindtap="goReviewPendingJobs">
      <text class="entry-icon">🧾</text>
      <text class="entry-title">审核待上架岗位</text>
      <text class="entry-desc">待处理 {{pendingJobCount}} 条</text>
    </view>
  </view>

  <view class="admin-tabbar">
    <view class="tab active">审核中心</view>
    <view class="tab" bindtap="goOrders">订单管理</view>
    <view class="tab" bindtap="goMine">我的信息</view>
  </view>
</view>
