@import './users.wxss';

.head-card .head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.job-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.35;
}

.status-pill {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
  min-height: 56rpx;
  min-width: 120rpx;
  box-sizing: border-box;
  text-align: center;
}

.phase-recruiting {
  background: #dcfce7;
  color: #166534;
}

.phase-progress {
  background: #dbeafe;
  color: #1d4ed8;
}

.phase-settling {
  background: #ffedd5;
  color: #c2410c;
}

.phase-done {
  background: #e2e8f0;
  color: #475569;
}

.sec {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 12rpx;
}

.row.strong {
  font-weight: 600;
  margin-top: 8rpx;
}

.proof-img {
  width: 100%;
  margin-top: 12rpx;
  border-radius: 12rpx;
  display: block;
}

.review-block {
  margin-top: 12rpx;
  padding: 16rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
}

.dispute-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.08);
}

.dispute-item:last-child {
  border-bottom: none;
}

.dispute-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.tag-type {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #4338ca;
  font-weight: 600;
}

.tag-status {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #475569;
}

.muted {
  font-size: 26rpx;
  color: #94a3b8;
}

.handle-btn {
  margin-top: 12rpx;
}

.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 40vh;
}

.cancel-btn-disabled {
  background: #cbd5e1 !important;
  color: #ffffff !important;
  border-color: #cbd5e1 !important;
}
