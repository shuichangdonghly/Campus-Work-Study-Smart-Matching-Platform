.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #F6F8FC 0%, #F2F4F8 100%);
  padding-bottom: 150rpx;
}

.card {
  background: #ffffff;
  padding: 28rpx;
  border-radius: 22rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 16rpx 40rpx rgba(16, 24, 40, 0.06);
}

.row {
  display: block;
  font-size: 28rpx;
  margin-bottom: 10rpx;
}

button {
  margin-bottom: 20rpx;
}

.outline-action-btn {
  border: 2rpx solid #4F46E5;
  background: #ffffff;
  color: #3730A3;
  border-radius: 14rpx;
  white-space: nowrap;
  width: 100%;
  box-sizing: border-box;
  font-size: 24rpx;
  line-height: 1.35;
  padding: 22rpx 10rpx;
  margin: 16rpx 0 0 0;
  font-weight: 500;
}

.outline-action-btn::after {
  border: none;
}

.profile-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 22vw;
  height: 22vw;
  min-width: 128rpx;
  min-height: 128rpx;
  max-width: 180rpx;
  max-height: 180rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
  overflow: hidden;
  background: #E2E8F0;
  border: 2rpx solid rgba(79, 70, 229, 0.12);
}

.name {
  font-size: 34rpx;
  font-weight: 600;
}

.role {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #7A869A;
}

.edit-link {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #4f46e5;
}

.section-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 16rpx;
}

.nav-card {
  padding: 0;
  overflow: hidden;
}

.nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
}

.nav-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #0f172a;
}

.nav-label-wrap {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}

.nav-badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #ef4444;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  box-sizing: border-box;
}

.nav-arrow {
  font-size: 40rpx;
  color: #94a3b8;
  line-height: 1;
}

.student-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  display: flex;
  border-top: 1rpx solid rgba(15, 23, 42, 0.08);
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #7A869A;
}

.tab.active {
  color: #4F46E5;
  font-weight: 600;
}
