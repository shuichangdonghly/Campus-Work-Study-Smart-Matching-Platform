.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #F6F8FC 0%, #F2F4F8 100%);
}

.tip-card {
  background: #ECFEFF;
  border: 1rpx solid #A5F3FC;
  border-radius: 14rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.tip-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #0F766E;
}

.tip-text {
  display: block;
  margin-top: 6rpx;
  color: #155E75;
  font-size: 24rpx;
}

.empty {
  text-align: center;
  color: #888;
  margin-top: 60rpx;
}

.card {
  background: #ffffff;
  padding: 24rpx;
  border-radius: 22rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 16rpx 40rpx rgba(16, 24, 40, 0.06);
  overflow: hidden;
}

.title {
  font-weight: 600;
  font-size: 30rpx;
  display: block;
  margin-bottom: 8rpx;
  word-break: break-all;
  overflow-wrap: anywhere;
}

.row {
  font-size: 26rpx;
  color: #555;
  display: block;
  margin-bottom: 6rpx;
  word-break: break-all;
  overflow-wrap: anywhere;
}

.detail-card {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 8rpx;
  gap: 10rpx;
}

.detail-row:last-child {
  margin-bottom: 0;
}

.detail-label {
  flex: 0 0 128rpx;
  color: #64748B;
  font-size: 24rpx;
}

.detail-value {
  flex: 1;
  color: #1F2937;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
  overflow-wrap: anywhere;
}

button {
  margin-top: 12rpx;
}

.code-input {
  margin-top: 12rpx;
  border: 1rpx solid #D1D5DB;
  border-radius: 10rpx;
  padding: 14rpx 16rpx;
  font-size: 26rpx;
  background: #fff;
}

.sign-btn {
  background: #16a34a !important;
  color: #ffffff !important;
  border-color: #15803d !important;
}

.submit-btn {
  background: #2563eb !important;
  color: #ffffff !important;
}

.submit-btn-disabled {
  background: #cbd5e1 !important;
  color: #64748b !important;
  border-color: #cbd5e1 !important;
}
