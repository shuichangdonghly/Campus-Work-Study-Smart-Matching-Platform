.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #F6F8FC 0%, #F2F4F8 100%);
}

.card {
  background: #ffffff;
  padding: 28rpx;
  border-radius: 22rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 16rpx 40rpx rgba(16, 24, 40, 0.06);
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.row {
  display: block;
  font-size: 28rpx;
  margin-bottom: 8rpx;
  color: #2D3748;
}

.block {
  display: block;
  font-size: 28rpx;
  margin: 16rpx 0;
  line-height: 1.5;
  color: #4B5563;
}

button {
  margin-top: 12rpx;
}

.btn-applied {
  background: #c0c4cc !important;
  border-color: #c0c4cc !important;
  color: #ffffff !important;
}

.map-title {
  margin-bottom: 12rpx;
}

.detail-map {
  width: 100%;
  height: 340rpx;
  border-radius: 16rpx;
}

.map-tip {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
}
