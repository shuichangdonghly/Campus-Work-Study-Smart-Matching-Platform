.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #F6F8FC 0%, #F2F4F8 100%);
  padding-bottom: 150rpx;
}

.top-card {
  background: #ffffff;
  border-radius: 22rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 16rpx 40rpx rgba(16, 24, 40, 0.06);
}

.h1 {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
}

.sub {
  display: block;
  font-size: 24rpx;
  color: #7A869A;
  margin-top: 6rpx;
}

.recommend-entry {
  margin-top: 16rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
  color: #fff;
  font-size: 24rpx;
}

.category-scroll {
  white-space: nowrap;
  margin-bottom: 18rpx;
}

.category-wrap {
  display: inline-flex;
  gap: 14rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #4B5563;
  background: #EEF2FF;
}

.tag-active {
  background: linear-gradient(135deg, #5B7CFF 0%, #8B5CF6 100%);
  color: #ffffff;
}

.empty {
  color: #888;
  text-align: center;
  margin-top: 80rpx;
}

.card {
  background: #ffffff;
  padding: 24rpx;
  border-radius: 22rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 16rpx 40rpx rgba(16, 24, 40, 0.06);
  border: 1rpx solid rgba(15, 23, 42, 0.06);
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.meta {
  font-size: 26rpx;
  color: #7A869A;
  display: block;
}

.student-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  display: flex;
  border-top: 1rpx solid rgba(15, 23, 42, 0.08);
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #7A869A;
}

.tab.active {
  color: #4F46E5;
  font-weight: 600;
}
