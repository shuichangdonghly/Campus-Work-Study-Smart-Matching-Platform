.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f6f8fc 0%, #f2f4f8 100%);
  padding-bottom: 24rpx;
}

.top-card {
  background: #ffffff;
  border-radius: 22rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 16rpx 40rpx rgba(16, 24, 40, 0.06);
}

.top-main {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
}

.h1 {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
}

.sub {
  display: block;
  font-size: 24rpx;
  color: #7a869a;
  margin-top: 6rpx;
}

.loc-input {
  margin-top: 14rpx;
  background: #eef2ff;
  border: 1rpx solid rgba(79, 70, 229, 0.2);
  border-radius: 12rpx;
  padding: 12rpx 14rpx;
}

.loc-input-label {
  display: block;
  font-size: 22rpx;
  color: #4338ca;
}

.loc-input-value {
  display: block;
  margin-top: 6rpx;
  font-size: 25rpx;
  color: #1e293b;
  line-height: 1.45;
  word-break: break-all;
}

.location-ok {
  background: #ecfdf5;
  border: 1rpx solid rgba(16, 185, 129, 0.2);
  border-radius: 14rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
  color: #065f46;
}

.filter-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 18rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
}

.filter-row {
  margin-bottom: 12rpx;
}

.filter-label {
  display: block;
  font-size: 24rpx;
  color: #475569;
  margin-bottom: 6rpx;
}

.filter-input {
  flex: 1;
  border: 1rpx solid rgba(15, 23, 42, 0.12);
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
  background: #fff;
}

/* 输入框获得焦点时高亮 */
.filter-input:focus {
  border:1rpx solid rgba(79,70,229,0.3);
  background:#fff;
  outline:none;
}

.my-placeholder {
  color:#94a3b8;
  font-size:26rpx;
  font-weight:400;
  letter-spacing:0.5rpx;
  font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  opacity:0.7;
  transition:opacity 0.2s ease;
}

.filter-btn {
  margin-top: 6rpx;
}

.card {
  background: #ffffff;
  padding: 24rpx;
  border-radius: 22rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 16rpx 40rpx rgba(16, 24, 40, 0.06);
  border: 1rpx solid rgba(15, 23, 42, 0.06);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #0f172a;
}

.match {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #dcfce7;
  color: #166534;
  font-weight: 600;
}

.meta {
  font-size: 26rpx;
  color: #64748b;
  display: block;
  margin-top: 6rpx;
}

.tag-wrap {
  margin-top: 12rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #4338ca;
  font-size: 22rpx;
}

.empty,
.loading {
  text-align: center;
  color: #94a3b8;
  margin: 36rpx 0;
  font-size: 24rpx;
}

