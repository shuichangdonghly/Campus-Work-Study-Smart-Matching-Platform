<view class="page">
  <view class="top-card">
    <text class="h1">兼职</text>
    <text class="sub">按分类快速找到合适岗位</text>
    <button class="recommend-entry" bindtap="goRecommend">AI 推荐岗位</button>
  </view>

  <scroll-view class="category-scroll" scroll-x="true">
    <view class="category-wrap">
      <view
        wx:for="{{categories}}"
        wx:key="*this"
        class="tag {{activeCategory === item ? 'tag-active' : ''}}"
        data-category="{{item}}"
        bindtap="pickCategory"
      >
        {{item}}
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{!filteredList.length}}" class="empty">当前分类暂无岗位</view>
  <view wx:for="{{filteredList}}" wx:key="_id" class="card" bindtap="open" data-id="{{item._id}}">
    <text class="title">{{item.title}}</text>
    <text class="meta">{{item.category || '其他'}} · {{item.location}}</text>
    <text class="meta">工分/人：{{item.rewardPoints}} · 招募：{{item.needCount}}人</text>
    <text class="meta">时间：{{item.timeDesc}}</text>
  </view>

  <view class="student-tabbar">
    <view class="tab active" bindtap="goJobs">兼职</view>
    <view class="tab" bindtap="goContact">联系</view>
    <view class="tab" bindtap="goMine">我的信息</view>
  </view>
</view>
