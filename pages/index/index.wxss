.page {
  padding: 24rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.page {
  background: linear-gradient(180deg, #F6F8FC 0%, #F2F4F8 100%);
}

.card {
  background: #ffffff;
  border-radius: 22rpx;
  padding: 26rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(16, 24, 40, 0.06);
  border: 1rpx solid rgba(15, 23, 42, 0.06);
}

.h1 {
  font-size: 40rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.sub {
  font-size: 26rpx;
  color: #666;
}

.row {
  display: block;
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 8rpx;
}

.actions button {
  margin: 0;
}
