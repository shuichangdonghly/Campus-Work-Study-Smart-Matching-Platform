.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #F6F8FC 0%, #F2F4F8 100%);
}

input {
  border: 1rpx solid rgba(15, 23, 42, 0.10);
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 8rpx;
  background: #fff;
}

button {
  margin-top: 20rpx;
}
