.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #F6F8FC 0%, #F2F4F8 100%);
}

.card {
  background: #ffffff;
  padding: 24rpx;
  border-radius: 22rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 16rpx 40rpx rgba(16, 24, 40, 0.06);
  overflow: hidden;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
}

.row {
  font-size: 28rpx;
  display: block;
  margin-top: 8rpx;
  word-break: break-all;
  overflow-wrap: anywhere;
}

.recruit-tip {
  display: block;
  margin-top: 10rpx;
  padding: 10rpx 14rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #166534;
  background: #ECFDF3;
  border: 1rpx solid #A7F3D0;
}

.sec {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin: 24rpx 0 12rpx;
}

.small {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-top: 6rpx;
  word-break: break-all;
  overflow-wrap: anywhere;
}

.detail-box {
  background: #F8FAFC;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  margin-top: 10rpx;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.detail-row:last-child {
  margin-bottom: 0;
}

.detail-label {
  font-size: 24rpx;
  color: #64748B;
  min-width: 120rpx;
  flex-shrink: 0;
}

.detail-value {
  font-size: 24rpx;
  color: #0F172A;
  flex: 1;
  min-width: 0;
  word-break: break-all;
  overflow-wrap: anywhere;
}

.pic {
  width: 100%;
  margin-top: 12rpx;
  border-radius: 8rpx;
}

button {
  margin-top: 12rpx;
}

.btn-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 10rpx;
}
