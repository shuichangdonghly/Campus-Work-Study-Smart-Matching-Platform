<view class="page" wx:if="{{user}}">
  <view class="card profile-card">
    <image src="{{user.avatarUrl || defaultAvatar}}" class="avatar" mode="aspectFill" binderror="onAvatarError"></image>
    <text class="name">{{displayName}}</text>
    <text class="role">
      {{user.role === 'admin' ? '管理员' : (user.role === 'student' ? '兼职者' : '发布者')}} · {{user.verifyStatus === 'approved' ? '已认证' : (user.verifyStatus === 'pending' ? '审核中' : '待认证')}}
    </text>
    <text class="edit-link" bindtap="goEditProfile">编辑资料</text>
  </view>

  <view class="card">
    <text class="section-title">账户与工分</text>
    <text class="row">当前余额：{{user.pointsBalance || 0}}</text>
    <button class="outline-action-btn" bindtap="goWallet">工分账户（充值 / 提现）</button>
  </view>

  <view class="card">
    <text class="section-title">商户认证</text>
    <view wx:if="{{user.role === 'publisher' && user.verifyStatus === 'approved' && publisherVerify}}">
      <text class="row">工号/商户编号：{{publisherVerify.workNo || '未填写'}}</text>
      <text class="row">单位/店铺：{{publisherVerify.unitName || '未填写'}}</text>
      <text class="row">补充说明：{{publisherVerify.remark || '未填写'}}</text>
    </view>
    <text class="row">审核状态：{{user.verifyStatus === 'approved' ? '已通过' : (user.verifyStatus === 'pending' ? '审核中' : (user.verifyStatus === 'rejected' ? '已驳回' : '待认证'))}}</text>
    <button class="outline-action-btn" wx:if="{{user.role === 'publisher' && user.verifyStatus !== 'approved' && user.verifyStatus !== 'pending'}}" bindtap="goVerify">
      去认证
    </button>
    <button class="outline-action-btn" wx:if="{{user.role === 'publisher' && user.verifyStatus === 'pending'}}" bindtap="goVerify">
      修改申请信息（审核中）
    </button>
  </view>

  <view class="card nav-card" bindtap="goMyJobs">
    <view class="nav-row">
      <text class="nav-label">我的发布</text>
      <text class="nav-arrow">›</text>
    </view>
  </view>

  <view class="card">
    <text class="section-title">角色与账号</text>
    <button class="outline-action-btn" bindtap="switchToStudent">切换为兼职者身份</button>
    <button class="outline-action-btn" wx:if="{{user.isAdmin}}" bindtap="goAdminCenter">返回管理员工作台</button>
  </view>

  <view class="publisher-tabbar">
    <view class="tab" bindtap="goCreate">发布</view>
    <view class="tab" bindtap="goContact">联系</view>
    <view class="tab active" bindtap="goMine">我的信息</view>
  </view>
</view>
