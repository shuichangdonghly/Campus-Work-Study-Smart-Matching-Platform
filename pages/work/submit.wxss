.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #F6F8FC 0%, #F2F4F8 100%);
}

.preview {
  width: 100%;
  margin: 20rpx 0;
  border-radius: 16rpx;
  box-shadow: 0 16rpx 40rpx rgba(16, 24, 40, 0.06);
}

.ta {
  width: 100%;
  min-height: 200rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.10);
  padding: 20rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

button {
  margin-bottom: 20rpx;
}

.pick-btn {
  background: #ffffff;
  color: #1f2937;
  border: 1rpx solid rgba(59, 130, 246, 0.35);
  border-radius: 14rpx;
  box-shadow: 0 10rpx 22rpx rgba(37, 99, 235, 0.16);
}
