.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f6f8fc 0%, #f2f4f8 100%);
  padding-bottom: 48rpx;
}

.balance-card {
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
  border-radius: 22rpx;
  padding: 36rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(79, 70, 229, 0.25);
}

.balance-label {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.balance-num {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: #ffffff;
  margin-top: 12rpx;
}

.card {
  background: #ffffff;
  border-radius: 22rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 16rpx 40rpx rgba(16, 24, 40, 0.06);
}

.actions-card {
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.primary-btn {
  border-radius: 14rpx;
  font-size: 30rpx;
}

.ghost-btn {
  border-radius: 14rpx;
  font-size: 30rpx;
  border: 2rpx solid #4f46e5;
  background: #ffffff;
  color: #3730a3;
}
