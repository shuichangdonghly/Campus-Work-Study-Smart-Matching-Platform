.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #F6F8FC 0%, #F2F4F8 100%);
}

.card {
  background: #ffffff;
  padding: 24rpx;
  border-radius: 22rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 16rpx 40rpx rgba(16, 24, 40, 0.06);
}

.title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.row {
  display: block;
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.hint {
  display: block;
  font-size: 24rpx;
  color: #6B7280;
}

.preset-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.preset-item {
  border: 2rpx solid #CBD5E1;
  border-radius: 10rpx;
  padding: 12rpx 18rpx;
  color: #334155;
  font-size: 24rpx;
}

.preset-item.active {
  border-color: #4F46E5;
  color: #3730A3;
  background: #EEF2FF;
}

.amount-input {
  border: 1rpx solid rgba(15, 23, 42, 0.12);
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}
