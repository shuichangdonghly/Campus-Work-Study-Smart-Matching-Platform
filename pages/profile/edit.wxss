.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #F6F8FC 0%, #F2F4F8 100%);
}

.card {
  background: #ffffff;
  padding: 28rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 16rpx 40rpx rgba(16, 24, 40, 0.06);
}

.title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.avatar {
  width: 24vw;
  height: 24vw;
  min-width: 140rpx;
  min-height: 140rpx;
  max-width: 200rpx;
  max-height: 200rpx;
  border-radius: 50%;
  display: block;
  margin: 0 auto 14rpx;
  border: 2rpx solid rgba(79, 70, 229, 0.15);
  overflow: hidden;
  background: #E2E8F0;
}

.avatar-btn {
  margin-bottom: 18rpx;
  border: 2rpx solid #4F46E5;
  background: #ffffff;
  color: #3730A3;
  border-radius: 14rpx;
}

.input {
  height: 84rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.15);
  padding: 0 20rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 180rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.15);
  padding: 14rpx 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.tip {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #64748B;
}
